# Google Gemini AI configuration (Primary AI Advisor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI configuration (Fallback AI Advisor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase configuration (PostgreSQL Database & Authentication)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# Copernicus Sentinel-2 configuration (Satellite Vegetation & NDVI)
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_STATS_URL=https://sh.dataspace.copernicus.eu/statistics/v1
SATELLITE_MAX_CLOUD=35

# Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Application URL
APP_URL=
